<?xml version="1.0" encoding="utf-8"?>
<!-- Muchas listas M3U usan enlaces http (sin "s"). Esto permite reproducirlos. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
